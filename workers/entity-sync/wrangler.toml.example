name = "grognard-entity-sync"
main = "src/index.ts"
compatibility_date = "2026-07-01"
workers_dev = true
preview_urls = false

# The single GitHub user id allowed to sync against this deployment. Numeric,
# not secret — set it here per deployment, or override with
# `wrangler secret put OWNER_GITHUB_ID` if you'd rather not commit it.
[vars]
OWNER_GITHUB_ID = "REPLACE_WITH_YOUR_GITHUB_NUMERIC_ID"

[[d1_databases]]
binding = "DB"
database_name = "grognard-entity-sync"
# Fill in after `wrangler d1 create grognard-entity-sync`.
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"
