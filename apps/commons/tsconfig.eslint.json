// Lint-only project: the build tsconfig excludes test files, but ESLint still needs
// them in a project for type-aware rules. Same sources, minus the test exclusions.
{
  "extends": "./tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/**/*.json",
    "src/types/**/*.d.ts",
    "../../packages/cwrc-leafwriter/src/types/assets.d.ts",
    "../../packages/cwrc-leafwriter/src/types/tibetan-ewts-converter.d.ts",
    "./package.json",
    "./.env-cmdrc.js"
  ],
  "exclude": ["node_modules", "server", "public"]
}
