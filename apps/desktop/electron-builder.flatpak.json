{
  "extends": "./electron-builder.base.json",
  "artifactName": "Grognard-linux-flatpak-${version}-${arch}.${ext}",
  "linux": {
    "target": ["flatpak"],
    "icon": "icons",
    "category": "Office",
    "syncDesktopName": true,
    "maintainer": "Daniel Patrick Morgan <daniel.morgan@college-de-france.fr>",
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": ["**/*", "!.deps-installed"]
      }
    ]
  },
  "flatpak": {
    "runtimeVersion": "24.08",
    "baseVersion": "24.08",
    "useWaylandFlags": true
  },
  "win": {
    "target": ["nsis"]
  }
}
