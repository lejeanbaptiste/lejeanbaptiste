{
  "extends": "./electron-builder.base.json",
  "publish": [
    {
      "provider": "github",
      "owner": "grognard",
      "repo": "grognard"
    }
  ],
  "artifactName": "Grognard-win-Setup-${version}-${arch}.${ext}",
  "beforePack": "./scripts/stage-game-assets.mjs",
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerHeader": "resources/branding/installer-header.bmp",
    "installerSidebar": "resources/branding/installer-sidebar.bmp",
    "uninstallerSidebar": "resources/branding/installer-sidebar.bmp",
    "include": "installer.nsh"
  },
  "win": {
    "target": ["nsis"],
    "icon": "resources/branding/icon.filled.png",
    "extraResources": [
      {
        "from": "resources/game-assets",
        "to": "game-assets",
        "filter": ["**/*", "!assets.bin"]
      },
      {
        "from": "resources/avatar-parts",
        "to": "avatar-parts"
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": ["**/*", "!.deps-installed"]
      }
    ]
  }
}
