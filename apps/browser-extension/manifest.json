{
  "manifest_version": 3,
  "name": "Grognard corpus import",
  "version": "0.3.0",
  "description": "Send the current Wikisource, Kanripo, or BDRC page to Grognard for TEI import.",
  "key": "",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": [
    "https://*.wikisource.org/*",
    "https://wikisource.org/*",
    "https://*.kanripo.org/*",
    "https://kanripo.org/*",
    "https://library.bdrc.io/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Import to Grognard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.wikisource.org/*", "https://wikisource.org/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://*.kanripo.org/*", "https://kanripo.org/*"],
      "js": ["content-kanripo.js"]
    },
    {
      "matches": ["https://library.bdrc.io/*"],
      "js": ["content-bdrc.js"]
    }
  ]
}
