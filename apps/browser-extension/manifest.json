{
  "manifest_version": 3,
  "name": "LJB corpus import",
  "version": "0.2.0",
  "description": "Send the current Wikisource or Kanripo page to Le Jean-Baptiste for TEI import.",
  "key": "",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": [
    "https://*.wikisource.org/*",
    "https://wikisource.org/*",
    "https://*.kanripo.org/*",
    "https://kanripo.org/*"
  ],
  "action": {
    "default_title": "Import to LJB",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wikisource.org/*", "https://wikisource.org/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://*.kanripo.org/*", "https://kanripo.org/*"],
      "js": ["content-kanripo.js"]
    }
  ]
}
