{
  "manifest_version": 3,
  "name": "LJB Wikisource import",
  "version": "0.1.0",
  "description": "Send the current Wikisource page to Le Jean-Baptiste for TEI import.",
  "key": "",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": ["https://*.wikisource.org/*", "https://wikisource.org/*"],
  "action": {
    "default_title": "Import to LJB",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wikisource.org/*", "https://wikisource.org/*"],
      "js": ["content.js"]
    }
  ]
}
